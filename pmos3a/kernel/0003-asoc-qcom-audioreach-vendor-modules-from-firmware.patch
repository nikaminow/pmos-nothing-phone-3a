+/*
+ * Vendor CAPI modules are loaded by the ADSP on demand once registered with its AMDB (on Android
+ * the audio HAL does this from ACDB). qcom/audioreach/amdb-modules.bin, if present, is the
+ * AMDB_CMD_REGISTER_MODULES payload (amdb_module_registration_t). Done before the first graph
+ * is opened, so the file may be installed after boot.
+ */
+static void q6apm_register_vendor_modules(struct q6apm *apm)
+{
+	const struct firmware *fw;
+	struct gpr_pkt *pkt;
+	int rc;
+
+	if (apm->vendor_modules_registered)
+		return;
+	if (firmware_request_nowarn(&fw, "qcom/audioreach/amdb-modules.bin", apm->dev))
+		return;
+	apm->vendor_modules_registered = true;
+
+	pkt = audioreach_alloc_cmd_pkt(fw->size, AMDB_CMD_REGISTER_MODULES, 0,
+				       GPR_APM_MODULE_IID, AMDB_MODULE_INSTANCE_ID);
+	if (!IS_ERR(pkt)) {
+		memcpy((void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE, fw->data, fw->size);
+		rc = q6apm_send_cmd_sync(apm, pkt, 0);
+		dev_info(apm->dev, "AMDB: registered vendor modules (%zu bytes): %d\n", fw->size, rc);
+		kfree(pkt);
+	}
+	release_firmware(fw);
+}
