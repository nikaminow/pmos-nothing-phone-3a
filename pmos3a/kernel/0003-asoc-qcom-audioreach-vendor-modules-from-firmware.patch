+/*
+ * Vendor CAPI modules (module IDs 0x17xxxxxx, e.g. a smart-amp speaker protection library the
+ * ADSP loads through AMDB): their calibration comes from the firmware file
+ * qcom/audioreach/module-<module id>.bin, a ready APM_CMD_SET_CFG payload (struct
+ * apm_module_param_data headers, each followed by its data padded to 8 bytes). The instance IDs in
+ * the file are replaced by this graph's instance of the module.
+ */
+static int audioreach_vendor_module_cfg(struct q6apm_graph *graph,
+					const struct audioreach_module *module)
+{
+	struct apm_module_param_data *param;
+	const struct firmware *fw;
+	struct gpr_pkt *pkt;
+	size_t off;
+	char name[48];
+	void *p;
+	int rc;
+
+	snprintf(name, sizeof(name), "qcom/audioreach/module-%08x.bin", module->module_id);
+	if (firmware_request_nowarn(&fw, name, graph->dev))
+		return 0;
+
+	pkt = audioreach_alloc_apm_cmd_pkt(fw->size, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt)) {
+		release_firmware(fw);
+		return PTR_ERR(pkt);
+	}
+
+	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	memcpy(p, fw->data, fw->size);
+	for (off = 0; off + sizeof(*param) <= fw->size;
+	     off += sizeof(*param) + ALIGN(param->param_size, 8)) {
+		param = p + off;
+		param->module_instance_id = module->instance_id;
+	}
+	if (off != fw->size) {
+		dev_err(graph->dev, "%s: bad param list\n", name);
+		rc = -EINVAL;
+	} else {
+		rc = q6apm_send_cmd_sync(graph->apm, pkt, 0);
+		dev_info(graph->dev, "module 0x%08x iid 0x%x: %zu bytes of calibration sent (%d)\n",
+			 module->module_id, module->instance_id, fw->size, rc);
+	}
+
+	kfree(pkt);
+	release_firmware(fw);
+
+	return rc;
+}
+
