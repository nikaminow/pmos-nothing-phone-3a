#!/bin/busybox sh
# 3a RAM initramfs: USB NCM network to the PC (172.16.42.1) + telnet shell.
/bin/busybox --install -s /bin
mkdir -p /proc /sys /dev /sys/kernel/config /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs dev /dev
mount -t configfs configfs /sys/kernel/config
echo "3a initramfs: waiting for the USB controller"
for i in $(seq 30); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break; sleep 1; done
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/acm.GS0 $G/functions/acm.GS1
echo 0x18d1 > $G/idVendor
echo 0xd003 > $G/idProduct
# two CDC ACM functions with IADs (composite class EF/02/01): Windows binds its inbox usbser.sys
# to each and shows two COM ports, no driver to install. GS0 (MI_00): rootfs + shell,
# GS1 (MI_02): live kernel log (3a-klog service -> pmos3a/klog-pc.py), survives hard hangs
echo 0xef > $G/bDeviceClass
echo 0x02 > $G/bDeviceSubClass
echo 0x01 > $G/bDeviceProtocol
echo "Nothing Phone 3a" > $G/strings/0x409/product
echo ACM > $G/configs/c.1/strings/0x409/configuration
ln -s $G/functions/acm.GS0 $G/configs/c.1/
ln -s $G/functions/acm.GS1 $G/configs/c.1/
ls /sys/class/udc | head -1 > $G/UDC
sleep 2
# clocal: open() must not wait for DTR/carrier, the PC script never raises it
stty -F /dev/ttyGS0 raw -echo clocal
# rootfs from the PC (pmos3a/send-rootfs.py): "SIZE\n" then the tar.gz on the COM port
mkdir -p /newroot /ram
mount -t tmpfs -o size=6G tmpfs /ram
echo "UDC: $(cat $G/UDC)  waiting for rootfs on the USB COM port..."
# one open for the whole transfer: closing ttyGS0 between the size and the data loses bytes;
# and termios resets on the last close, so set raw mode on this open fd, not with stty -F before
exec 3< /dev/ttyGS0
stty raw -echo -ixon -ixoff -icrnl -inlcr -istrip clocal <&3
read -r SZ <&3
echo "receiving $SZ bytes"
head -c "$SZ" <&3 > /ram/rootfs
echo "got $(stat -c %s /ram/rootfs) of $SZ bytes, md5 $(md5sum /ram/rootfs | cut -c1-12)"
if [ "$(head -c 4 /ram/rootfs)" = hsqs ]; then
	# squashfs (send-rootfs.py out/rootfs.sqfs): stays compressed in RAM, writes go to a tmpfs
	# overlay; about 1 GB less RAM than unpacking, and no unpack time
	insmod /lib/squashfs.ko
	insmod /lib/overlay.ko
	mkdir -p /ram/ro /ram/upper /ram/work
	mount -t squashfs -o loop,ro /ram/rootfs /ram/ro &&
		mount -t overlay overlay -o lowerdir=/ram/ro,upperdir=/ram/upper,workdir=/ram/work /newroot &&
		mkdir -p /newroot/mnt/ram && mount --move /ram /newroot/mnt/ram
else
	# tar.gz (old format)
	mount -t tmpfs -o size=6G tmpfs /newroot
	tar -xzf /ram/rootfs -C /newroot
	umount /ram
fi
[ -x /newroot/sbin/init ] && {
	echo "rootfs received, starting it"
	umount /sys/kernel/config 2>/dev/null
	mount --move /dev /newroot/dev; mount --move /proc /newroot/proc; mount --move /sys /newroot/sys
	exec switch_root /newroot /sbin/init
}
echo "rootfs failed"
exec sh
