// SPDX-License-Identifier: BSD-3-Clause
/*
 * Nothing Phone (3a) speaker amps, stage A of AUDIO-PLAN.md: only the I2C bus (QUP1 SE6,
 * i2c@898000, as Nura's i2c13 on the Phone (4a)), no amp driver, so the TFA98xx can only be
 * read. Their resets (gpio141/142, active high on TFA) are left alone here.
 * Applied at runtime by 3a-ovl-audio-i2c.ko.
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/clock/qcom,milos-gcc.h>
#include <dt-bindings/dma/qcom-gpi.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interconnect/qcom,icc.h>
#include <dt-bindings/interconnect/qcom,milos-rpmh.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

&tlmm {
	qup_i2c13_data_clk: qup-i2c13-data-clk-state {
		/* SDA, SCL */
		pins = "gpio59", "gpio60";
		function = "qup1_se6";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&gpi_dma1 {
	status = "okay";
};

&qupv3_id_1 {
	#address-cells = <2>;
	#size-cells = <2>;
	status = "okay";

	i2c@898000 {
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x00898000 0x0 0x4000>;

		interrupts = <GIC_SPI 461 IRQ_TYPE_LEVEL_HIGH 0>;

		clocks = <&gcc GCC_QUPV3_WRAP1_S6_CLK>;
		clock-names = "se";

		interconnects = <&clk_virt MASTER_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS
				 &clk_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>,
				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
				 &cnoc_cfg SLAVE_QUP_1 QCOM_ICC_TAG_ACTIVE_ONLY>,
				<&aggre1_noc MASTER_QUP_1 QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "qup-core",
				     "qup-config",
				     "qup-memory";

		dmas = <&gpi_dma1 0 6 QCOM_GPI_I2C>,
		       <&gpi_dma1 1 6 QCOM_GPI_I2C>;
		dma-names = "tx",
			    "rx";

		pinctrl-0 = <&qup_i2c13_data_clk>;
		pinctrl-names = "default";

		clock-frequency = <400000>;

		#address-cells = <1>;
		#size-cells = <0>;

		status = "okay";

		/*
		 * Stage B: the two TFA9873 as in the vendor DT (no irq line, reset pulse active
		 * high). The ported snd-soc-tfa98xx.ko is not in the module tree, so nothing binds
		 * them until it is insmod'ed by hand; with allow_start=0 it never powers them up.
		 */
		amp@34 {
			compatible = "tfa,tfa98xx";
			reg = <0x34>;
			reset-gpios = <&tlmm 141 GPIO_ACTIVE_HIGH>;
		};

		amp@35 {
			compatible = "tfa,tfa98xx";
			reg = <0x35>;
			reset-gpios = <&tlmm 142 GPIO_ACTIVE_HIGH>;
		};
	};
};
