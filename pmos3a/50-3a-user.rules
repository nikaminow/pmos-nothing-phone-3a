// RAM-boot phone: tinydm's autologin session may have no seat, so polkit's "active local"
// defaults deny Plasma ("Not authorized to control networking"); the user's groups decide instead.
polkit.addRule(function(action, subject) {
	if (subject.isInGroup("netdev") && action.id.indexOf("org.freedesktop.NetworkManager.") == 0)
		return polkit.Result.YES;
	if (subject.isInGroup("plugdev") && action.id.indexOf("org.freedesktop.ModemManager1.") == 0)
		return polkit.Result.YES;
});
